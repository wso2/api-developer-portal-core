<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>API Portal &amp; MCP Hub</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {{!-- Rebuilt on the same auth shell as the sign-in page.

          There is no upstream counterpart to compare against - the on-prem portal serves a
          single organization and has no picker - so the reference is our own sign-in page,
          which is itself the port of upstream's auth shell. The two are siblings: both are
          what a visitor meets before any organization or session exists, so they should be
          one design.

          Bootstrap and getbootstrap.com's docs.css are gone with the old markup. The shell
          is self-contained, and that docs.css URL 404s - it was fetching an error page on
          every visit. /styles/main.css is gone too: it is the themable sheet, and this page
          renders before an organization is known, so there is no theme to apply. --}}
    <link rel="stylesheet" href="/technical-styles/auth-shell.css">
    <script src='/technical-scripts/common.js' defer></script>
</head>

<body>

    <div class="auth-root">

        <!-- ── LEFT: brand panel ─────────────────────────────────── -->
        <div class="auth-brand">
            <div class="auth-logo-row">
                <img class="auth-logo-svg" src="/images/api-portal-logo-white.svg" alt="API Portal &amp; MCP Hub" />
            </div>

            <div class="auth-brand-body">
                <span class="auth-tenant-pill">Unified portal for APIs &amp; MCP</span>
                <h1 class="auth-headline">Discover, integrate, and ship faster.</h1>
                <p class="auth-desc">One place to explore published APIs and MCP servers, try them live, and manage your
                    subscriptions and keys.</p>

                <div class="ln-features">
                    <div class="ln-feature-item">
                        <span class="ln-feature-icon"><i class="bi bi-compass"></i></span>
                        <span class="ln-feature-text">Discover and explore published APIs and MCP servers</span>
                    </div>
                    <div class="ln-feature-item">
                        <span class="ln-feature-icon"><i class="bi bi-terminal"></i></span>
                        <span class="ln-feature-text">Try out APIs live with interactive consoles</span>
                    </div>
                    <div class="ln-feature-item">
                        <span class="ln-feature-icon"><i class="bi bi-key"></i></span>
                        <span class="ln-feature-text">Subscribe, then manage your access keys and tokens</span>
                    </div>
                </div>
            </div>

            <div class="auth-foot-desktop">
                <span id="ln-year"></span>
            </div>
        </div>

        <!-- ── RIGHT: organization picker ────────────────────────── -->
        <div class="auth-form">
            <div class="auth-form-inner ln-form-inner">
                <h2 class="auth-form-title">Find your portal</h2>
                <p class="auth-form-sub">Enter your organization name to open its API Portal &amp; MCP Hub.</p>

                <form id="org-picker-form" class="ln-fields">
                    <div class="auth-field">
                        <label class="auth-field-label" for="organization-name">Organization Name</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-building auth-input-icon" aria-hidden="true"></i>
                            {{!-- id is getOrgName()'s contract in common.js - it reads
                                  #organization-name and navigates to /<orgName>. --}}
                            <input type="text" id="organization-name" class="auth-input"
                                placeholder="Enter your organization name" required autocomplete="organization" />
                        </div>
                    </div>

                    <button type="submit" class="ln-signin-btn auth-continue-btn auth-continue-btn--active">
                        Continue
                    </button>
                </form>
            </div>
        </div>

        <!-- Mobile footer -->
        <div class="auth-foot-mobile">
            <span id="ln-year-m"></span>
        </div>

    </div>

    <script>
      (function () {
        var y = new Date().getFullYear();
        ['ln-year', 'ln-year-m'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.textContent = '© ' + y + ' WSO2';
        });
        /* A form rather than a bare button, so Enter submits as well as the click.
           getOrgName lives in common.js as a top-level declaration, so it is hoisted and
           available even though that file's DOMContentLoaded handler throws on this page -
           it dereferences #collapseBtn, which no pre-auth page has. */
        var form = document.getElementById('org-picker-form');
        if (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (typeof getOrgName === 'function') getOrgName();
          });
        }
      })();
    </script>

</body>

</html>

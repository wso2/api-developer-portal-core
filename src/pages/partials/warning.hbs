<head>
  <link rel='stylesheet' href='/technical-styles/warning.css' />
  <script src="/technical-scripts/warning.js" defer></script> 
  <script src='/technical-scripts/create-org.js' defer></script>
</head>

<body>
  <section>
    <div
      class='modal fade delete-alert'
      id='warningModal'
      tabindex='-1'
      aria-hidden='true'
    >
      <div class='modal-dialog'>
        <div class='modal-content dp-modal'>
          <div class='modal-header dp-modal-head'>
            <h5 class='modal-title dp-modal-title' id="modalTitle">{{modalTitle}}</h5>
          </div>
          <div class='modal-body dp-modal-body'>
            <p class='modal-message' id="modalMessage">{{modalMessage}}</p>
          </div>
          <div class='modal-footer dp-modal-footer'>
            <button
              type='button'
              class='dp-btn dp-btn--outline'
              data-bs-dismiss='modal'
            >
              Cancel
            </button>
            <button
              type='button'
              class='dp-btn dp-btn--primary dp-btn--danger-solid'
              data-bs-dismiss='modal'
              id="modalFunction"
              data-cyid="confirm"
            >
              Confirm
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</body>
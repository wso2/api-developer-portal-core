<div class='modal fade' id='deleteConfirmation' tabindex='-1' aria-hidden='true'>
    <div class='modal-dialog'>
        <div class='modal-content dp-modal'>
            <div class='modal-header dp-modal-head'>
                <h5 class='modal-title dp-modal-title'>{{modalTitle}}</h5>
            </div>
            <div class='modal-body dp-modal-body'>
                <p class='modal-message'>{{modalMessage}}</p>
            </div>
            <div class='modal-footer dp-modal-footer'>
                <button type='button' class='dp-btn dp-btn--outline' data-bs-dismiss='modal'>
                    Cancel
                </button>
                <button
                    type='button'
                    class='dp-btn dp-btn--primary dp-btn--danger-solid'
                    data-bs-dismiss='modal'
                    id='deleteConfirmationBtn'
                    data-cyid="confirm"
                >
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<head>
  <link rel='stylesheet' href='/technical-styles/overview.css' />
</head>

{{!-- Breadcrumb, matching upstream's application overview.

      The bar is its own wrapper, not the nav itself. Both classes on one element left the
      trail with no horizontal gutter, so it started at the content-area edge while this
      page's own content started 12px further in - the same container-fluid wrapper the API
      and MCP landing pages use puts them on the one line. --}}
<div class="container-fluid dp-breadcrumb-bar">
  <nav class="dp-breadcrumb">
    <a class="dp-breadcrumb-item" href="{{baseUrl}}/applications">Applications</a>
    {{#if applicationMetadata.name}}
    <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
    <span class="dp-breadcrumb-current">{{applicationMetadata.name}}</span>
    {{/if}}
  </nav>
</div>

<section class="section mt-0 mb-6">
  <div class="container-fluid">
    {{> application-identity }}
  </div>
</section>
<div class="modal custom-modal api-key-name-modal" id="apiKeyNameModal-{{subID}}-{{keyType}}">
    <div class="modal-dialog modal-dialog-centered api-key-name-modal-dialog" role="document">
        <div class="modal-content custom-modal-content dp-modal">
            <div class="custom-modal-header dp-modal-head">
                <h2 class="custom-modal-title dp-modal-title m-0">Generate API Key</h2>
                <button type="button" class="dp-modal-close" data-bs-dismiss="modal" aria-label="Close"
                    onclick="closeModal('apiKeyNameModal-{{subID}}-{{keyType}}')"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="custom-modal-body">
                <div class="container">
                    <div class="row">
                        <div class="px-0">
                            <div class="mb-3">
                                <label for="apiKeyName-{{subID}}-{{keyType}}" class="form-label">API Key name</label>
                                <input type="text"
                                       id="apiKeyName-{{subID}}-{{keyType}}"
                                       class="form-control"
                                       placeholder="Enter API key name"
                                       required maxlength="50" minlength="3" />
                            </div>
                            <div class="d-flex justify-content-end mt-4 mb-3">
                                <button class="dp-btn dp-btn--outline me-3" type="button"
                                    onClick="closeModal('apiKeyNameModal-{{subID}}-{{keyType}}')">
                                    Cancel
                                </button>
                                <button class="dp-btn dp-btn--primary" id="confirmAPIKeyNameBtn-{{subID}}-{{keyType}}">
                                    <span class="button-normal-state">
                                        Generate
                                    </span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



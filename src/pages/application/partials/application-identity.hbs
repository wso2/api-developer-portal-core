{{!--
 * Copyright (c) 2026, WSO2 LLC. (http://www.wso2.com) All Rights Reserved.
 *
 * The application's name and description, editable in place.
 *
 * Extracted so the overview and the manage-keys page can share one copy. Upstream renders
 * both of those as partials of a single /applications/<id> page, so its edit affordance is
 * simply always on screen; ours splits manage-keys onto its own route, which is why it
 * needed pulling out rather than duplicating.
 *
 * Every id here is edit-application-form.js's contract: applicationName,
 * applicationDescription, editNameBtn, editDescriptionBtn, saveNameBtn, saveDescriptionBtn,
 * cancelNameBtn, cancelDescriptionBtn, nameEditActions, descriptionEditActions,
 * nameEditError, descriptionEditError, and inlineEditForm. The script bails early when the
 * name and description are both absent, but reads inlineEditForm.dataset unguarded - so the
 * form element has to travel with the rest of the block.
 *
 * Callers must load /technical-styles/overview.css and
 * /technical-scripts/edit-application-form.js.
--}}
<div class="app-overview-card d-flex justify-content-between align-items-start">
  <div class="me-5 w-75">
    {{#applicationMetadata}}
    <div class="d-flex align-items-center edit-container mb-2">
      <h3 class="app-overview-title" id="applicationName" data-original="{{name}}">{{name}}</h3>
      <button class="btn btn-sm edit-inline-btn {{#if @root.isReadOnlyMode}}disabled border-0{{/if}}"
        id="editNameBtn" title="Edit name">
        <i class="bi bi-pencil"></i>
      </button>
      <div class="edit-actions" id="nameEditActions" style="display: none;">
        <button class="btn btn-sm common-btn-primary save-btn" id="saveNameBtn" title="Save">
          <span class="button-normal-state"><i class="bi bi-check"></i></span>
          <span class="button-loading-state" style="display: none;">
            <span class="spinner-border spinner-border-sm" role="status"></span>
          </span>
        </button>
        <button class="btn btn-sm common-btn-outlined cancel-btn" id="cancelNameBtn" title="Cancel"><i
            class="bi bi-x"></i></button>
      </div>
    </div>
    <div id="nameEditError" class="edit-error-message mb-2" style="display: none;"></div>
    <div class="d-flex align-items-center edit-container mb-2">
      {{#if description}}
      <p class="app-description mb-0" id="applicationDescription" data-original="{{description}}">{{description}}
      </p>
      <button class="btn btn-sm edit-inline-btn {{#if @root.isReadOnlyMode}}disabled border-0{{/if}}"
        id="editDescriptionBtn" title="Edit description">
        <i class="bi bi-pencil"></i>
      </button>
      {{else}}
      <button class="btn btn-sm common-btn-link p-0 {{#if @root.isReadOnlyMode}}disabled border-0{{/if}}"
        id="editDescriptionBtn" title="Add description">
        <i class="bi bi-plus"></i> Add description
      </button>
      <p class="app-description" id="applicationDescription" data-original="{{null}}"></p>
      {{/if}}
      <div class="edit-actions" id="descriptionEditActions" style="display: none;">
        <button class="btn btn-sm common-btn-primary save-btn" id="saveDescriptionBtn" title="Save">
          <span class="button-normal-state"><i class="bi bi-check"></i></span>
          <span class="button-loading-state" style="display: none;">
            <span class="spinner-border spinner-border-sm" role="status"></span>
          </span>
        </button>
        <button class="btn btn-sm common-btn-outlined cancel-btn" id="cancelDescriptionBtn" title="Cancel"><i
            class="bi bi-x"></i></button>
      </div>
    </div>
    <div id="descriptionEditError" class="edit-error-message" style="display: none;"></div>
    {{!-- ../ because this sits inside {{#applicationMetadata}}: the partial's own
          parameters live one context up, and reading the bare name here resolved against
          the metadata object instead, where it is undefined - so the flag did nothing. --}}
    {{#unless ../hideSubscriptionCount}}
    <p class="app-subscription-count mt-3">Subscriptions: {{subscriptionCount}}</p>
    {{/unless}}
    {{/applicationMetadata}}
  </div>

  {{!-- The overview shows a link through to the keys; the keys page itself does not need
        one back to where it already is. --}}
  {{#unless hideKeysLink}}
  <div class="oauth2-keys-section">
    <h5 class="oauth2-title mb-2">Keys</h5>
    <a href="{{baseUrl}}/applications/{{applicationMetadata.id}}/manage-keys" class="common-btn-primary">
      <i class="bi bi-key me-1"></i> Manage Keys
    </a>
  </div>
  {{/unless}}
</div>
<form id="inlineEditForm" data-application-id="{{applicationMetadata.id}}" style="display: none;"></form>

<head>
  <link rel='stylesheet' href='/technical-styles/applications.css' />
  <script src='/technical-scripts/application-listing.js' defer></script>
  <script src='/technical-scripts/add-application-form.js' defer></script>
</head>

{{!-- Ported to upstream's applications page: page-header with a title and description,
      a dp-empty state, and an apps-grid of app-cards.

      The create flow is ours, not upstream's. Upstream opens a modal; we expand a card
      into a form, driven by add-application-form.js. Every id that script reads is kept
      exactly - applicationCreateCard, applicationCreateForm, createApplicationCardWrapper,
      applicationForm, applicationName, applicationDescription, nameError,
      descriptionError, remainingCharacters, createAppButton, cancelCreateButton,
      createButton, message-overlay - so no JS changed.

      Three of those ids were missing from this template entirely: applicationDescription,
      descriptionError and remainingCharacters. add-application-form.js dereferences all
      three unguarded (`descriptionTextarea.addEventListener` at line 112, and
      `descriptionError.style` inside validateForm), so its DOMContentLoaded handler threw
      on every visit and the form-submit guard below it never registered. Rendering the
      description field - which upstream's create form has too - is what fixes that. --}}
<section class="apps-section">
  <div class="apps-page-container" id="applicationsContainer">

    <div class="page-header">
      <div>
        <h1 class="page-title">Applications</h1>
        <p class="page-desc">Applications hold the API keys and subscriptions you use to call APIs.</p>
      </div>
      {{#if applicationsMetadata.length}}
      <button class="apps-create-btn" id="createButton" type="button"
        onclick="toggleCreateCard()" {{#if @root.isReadOnlyMode}}disabled{{/if}}>
        <i class="bi bi-plus"></i> Create application
      </button>
      {{/if}}
    </div>

    {{!-- Empty state. The create card below is revealed in its place when there are no
          applications, so this button only has to open the form. --}}
    {{#unless applicationsMetadata.length}}
    <div class="dp-empty">
      <span class="dp-empty-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
      <h2 class="dp-empty-title">No applications yet</h2>
      <p class="dp-empty-desc">Create an application to generate API keys and subscribe to APIs. You can manage all your credentials in one place.</p>
    </div>
    {{/unless}}

    <div class="apps-grid">

      {{!-- Create application card. Hidden once applications exist - the header button
            reveals it then. --}}
      <div class="{{#if applicationsMetadata.length}}d-none{{/if}}" id="createApplicationCardWrapper">
        <div class="create-application-card card {{#if @root.isReadOnlyMode}}disabled{{/if}} {{#if applicationsMetadata.length}}d-none{{/if}}"
          id="applicationCreateCard"
          style="{{#if @root.isReadOnlyMode}}pointer-events: none; opacity: 0.5;{{else}} cursor: pointer; {{/if}}"
          onclick="showApplicationForm()">
          <span class="plus-icon">+</span>
          <span class="create-text">Create Application</span>
        </div>

        <div class="application-create-card card d-none" id="applicationCreateForm">
          <div class="application-layout">
            <div class="application-content">
              <form id='applicationForm' class='create-app-form'>
                <div class="app-form-group">
                  <label for="applicationName">Application name <span class="app-required">*</span></label>
                  <input type="text" id="applicationName" class="form-control" placeholder="e.g. My Mobile App"
                    maxlength="100" autocomplete="off" required />
                  <div id="nameError" class="error-msg text-danger mt-1 d-none">
                    Application name cannot be empty.
                  </div>
                </div>

                <div class="app-form-group">
                  <label for="applicationDescription">Description</label>
                  <textarea id="applicationDescription" class="form-control" rows="3" maxlength="256"
                    placeholder="What is this application for? (optional)" style="resize:vertical;"></textarea>
                  <div class="app-form-hint">
                    <span id="remainingCharacters">256</span> characters remaining
                  </div>
                  <div id="descriptionError" class="error-msg text-danger mt-1" style="display:none;">
                    Description is too long.
                  </div>
                </div>

                <div class="application-card-footer">
                  <button type='button' class='btn common-btn-outlined add-application-action-btn' id='cancelCreateButton'
                    data-has-apps="{{#if applicationsMetadata.length}}true{{else}}false{{/if}}"
                    onclick="event.stopPropagation(); hideApplicationForm(this);">
                    Cancel
                  </button>
                  <button type='submit' class='btn common-btn-primary add-application-action-btn' id='createAppButton'>
                    Create
                  </button>
                </div>
              </form>
            </div>
            <div class="message-overlay hidden" id="message-overlay">
              <div class="message-content">
                <i class="bi message-icon"></i>
                <p class="message-text"></p>
              </div>
              <button type="button" class="close-message" aria-label="Close message">&times;</button>
            </div>
          </div>
        </div>
      </div>

      {{!-- Application cards --}}
      {{#applicationsMetadata}}
      <div class="app-card" id="app-card-{{id}}" data-id="{{id}}" data-name="{{name}}"
        style="cursor:pointer;" onclick="window.location.href='{{../baseUrl}}/applications/{{id}}'">

        <div class="app-card-top">
          <span class="app-avatar">{{firstTwoLetters name}}</span>
          <div class="app-card-meta">
            <h3 class="app-card-name">{{name}}</h3>
            <span class="subscription-count-badge">Subscriptions: {{subscriptionCount}}</span>
          </div>
        </div>

        <p class="app-card-desc">{{description}}</p>

        <div class="app-card-footer">
          <a href="{{../baseUrl}}/applications/{{id}}" class="application-name-link"
            onclick="event.stopPropagation();">View details</a>
          <button type="button" class="app-delete-btn {{#if @root.isReadOnlyMode}}disabled{{/if}}"
            title="Delete application" id="trash-btn-{{id}}"
            onclick="event.stopPropagation(); openWarningModal('deleteApplication', '{{id}}')">
            <i class="bi bi-trash"></i>
          </button>
        </div>

        <div class="message-overlay hidden" id="message-overlay-{{id}}">
          <div class="message-content">
            <i class="bi message-icon"></i>
            <p class="message-text"></p>
          </div>
          <button type="button" class="close-message" aria-label="Close message">&times;</button>
        </div>
      </div>
      {{/applicationsMetadata}}

    </div>
  </div>
</section>

<head>
  <link rel='stylesheet' href='/technical-styles/applications.css' />
  <script src='/technical-scripts/application-listing.js' defer></script>
  <script src='/technical-scripts/add-application-form.js' defer></script>
</head>

{{!-- Ported to upstream's applications page: page-header with a title and description,
      a dp-empty state, and an apps-grid of app-cards.

      The create flow is upstream's dialog carrying our form. add-application-form.js still
      owns validation and the POST; only its show/hide functions changed, from expanding a
      card in the grid to opening the modal at the foot of this file.

      Three ids this template never rendered - applicationDescription, descriptionError and
      remainingCharacters - are now present. add-application-form.js dereferences all three
      unguarded (`descriptionTextarea.addEventListener`, and `descriptionError.style` inside
      validateForm), so its DOMContentLoaded handler threw on every visit and the
      form-submit guard below it never registered. --}}
<section class="apps-section">
  <div class="apps-page-container" id="applicationsContainer">

    <div class="page-header">
      <div>
        <h1 class="page-title">Applications</h1>
        <p class="page-desc">Applications hold the API keys and subscriptions you use to call APIs.</p>
      </div>
      {{#if applicationsMetadata.length}}
      <button class="apps-create-btn" id="createButton" type="button"
        {{#if @root.isReadOnlyMode}}disabled{{/if}}>
        <i class="bi bi-plus"></i> Create application
      </button>
      {{/if}}
    </div>

    {{!-- Empty state. Carries its own create button now that the grid no longer holds a
          plus-card to click. --}}
    {{#unless applicationsMetadata.length}}
    <div class="dp-empty">
      <span class="dp-empty-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
      <h2 class="dp-empty-title">No applications yet</h2>
      <p class="dp-empty-desc">Create an application to generate API keys and subscribe to APIs. You can manage all your credentials in one place.</p>
      <button type="button" class="apps-create-btn" id="createButtonEmpty"
        {{#if @root.isReadOnlyMode}}disabled{{/if}}>
        <i class="bi bi-plus"></i> Create application
      </button>
    </div>
    {{/unless}}

    <div class="apps-grid">

      {{!-- Application cards --}}
      {{#applicationsMetadata}}
      <div class="app-card" id="app-card-{{id}}" data-id="{{id}}" data-name="{{name}}"
        style="cursor:pointer;" onclick="window.location.href='{{../baseUrl}}/applications/{{id}}'">

        <div class="app-card-top">
          <span class="app-avatar">{{firstTwoLetters name}}</span>
          <div class="app-card-meta">
            <h3 class="app-card-name">{{name}}</h3>
            <span class="subscription-count-badge">Subscriptions: {{subscriptionCount}}</span>
          </div>
        </div>

        <p class="app-card-desc">{{description}}</p>

        {{!-- Footer carries the delete button alone, as upstream's does. The whole card is
              already a link to the application, so a "View details" action beside it was
              a second route to the same place. --}}
        <div class="app-card-footer">
          <button type="button" class="app-delete-btn {{#if @root.isReadOnlyMode}}disabled{{/if}}"
            title="Delete application" id="trash-btn-{{id}}"
            onclick="event.stopPropagation(); openWarningModal('deleteApplication', '{{id}}')">
            <i class="bi bi-trash"></i>
          </button>
        </div>

        <div class="message-overlay hidden" id="message-overlay-{{id}}">
          <div class="message-content">
            <i class="bi message-icon"></i>
            <p class="message-text"></p>
          </div>
          <button type="button" class="close-message" aria-label="Close message">&times;</button>
        </div>
      </div>
      {{/applicationsMetadata}}

    </div>
  </div>
</section>

{{!-- ── Create application modal ──
      Upstream's dialog shell, carrying our form. Every id add-application-form.js reads
      is preserved - applicationForm, applicationName, applicationDescription, nameError,
      descriptionError, remainingCharacters, createAppButton, cancelCreateButton and
      message-overlay - so the validation and the POST are untouched; only the
      show/hide functions changed, from toggling a card to opening this. --}}
<div class="app-modal-overlay" id="app-create-modal" role="dialog" aria-modal="true"
  aria-labelledby="app-create-modal-title">
  <div class="app-modal">
    <div class="app-modal-head">
      <div class="app-modal-head-left">
        <span class="app-modal-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
        <h2 class="app-modal-title" id="app-create-modal-title">Create application</h2>
      </div>
      <button type="button" class="app-modal-close" id="app-create-close" aria-label="Close">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <form id="applicationForm" class="create-app-form">
      <div class="app-modal-body">
        <div class="app-form-group">
          <label for="applicationName">Application name <span class="app-required">*</span></label>
          <input type="text" id="applicationName" class="app-form-input" placeholder="e.g. My Mobile App"
            maxlength="100" autocomplete="off" required />
          <div id="nameError" class="error-msg text-danger mt-1 d-none">
            Application name cannot be empty.
          </div>
        </div>

        <div class="app-form-group">
          <label for="applicationDescription">Description</label>
          <textarea id="applicationDescription" class="app-form-input" rows="3" maxlength="256"
            placeholder="What is this application for? (optional)" style="resize:vertical;"></textarea>
          <div class="app-form-hint">
            <span id="remainingCharacters">256</span> characters remaining
          </div>
          <div id="descriptionError" class="error-msg text-danger mt-1" style="display:none;">
            Description is too long.
          </div>
        </div>
      </div>

      <div class="app-modal-footer">
        <button type="button" class="app-btn-secondary" id="cancelCreateButton"
          data-has-apps="{{#if applicationsMetadata.length}}true{{else}}false{{/if}}">
          Cancel
        </button>
        <button type="submit" class="app-btn-primary" id="createAppButton" disabled>
          Create
        </button>
      </div>
    </form>

    <div class="message-overlay hidden" id="message-overlay">
      <div class="message-content">
        <i class="bi message-icon"></i>
        <p class="message-text"></p>
      </div>
      <button type="button" class="close-message" aria-label="Close message">&times;</button>
    </div>
  </div>
</div>

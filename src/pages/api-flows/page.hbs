</head>

{{> header profile=profile baseUrl=baseUrl showApiWorkflowsNav=showApiWorkflowsNav}}
{{> sidebar profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav}}

{{!-- Upstream's settings shell: page padding rather than a centred container, a back
      link above a page heading, then a vertical rail beside the content column. Both of
      our panels are the two upstream files under its AI & DISCOVERY group, so the rail
      carries that group's heading and its two icons.

      The rail is anchors, as upstream's is, but the click handler stays ours: the ids
      llms-tab-btn / workflows-tab-btn and the hashes #llm-instruction / #apiflows are
      api-flows.js's contract - it activates a tab from the hash on load and on
      hashchange, so the sidebar's Settings link keeps landing on the right panel.
      preventDefault stops the anchor from also jumping while replaceState rewrites the
      URL, which is what upstream's settings-nav.js does for the same reason. --}}
<div class="cfg-page">

    <a href="{{baseUrl}}/" class="cfg-back-link">
        <i class="bi bi-arrow-left"></i> Home
    </a>
    <h1 class="cfg-heading">Settings</h1>

    <div class="cfg-layout">

        <nav class="cfg-nav" aria-label="Settings navigation">
            <div class="cfg-nav-section">AI &amp; Discovery</div>
            <div class="cfg-nav-items" role="tablist">
                <a href="#llm-instruction" class="cfg-nav-item active" id="llms-tab-btn" role="tab"
                    aria-selected="true" aria-controls="llmsTabContent"
                    onclick="event.preventDefault(); activateTab(this); history.replaceState(null,'',location.pathname+'#llm-instruction')">
                    <i class="bi bi-stars"></i><span>LLM Instructions</span>
                </a>
                <a href="#apiflows" class="cfg-nav-item" id="workflows-tab-btn" role="tab"
                    aria-selected="false" aria-controls="workflowsTabContent"
                    onclick="event.preventDefault(); activateTab(this); history.replaceState(null,'',location.pathname+'#apiflows')">
                    <i class="bi bi-diagram-3"></i><span>API Workflows</span>
                </a>
            </div>
        </nav>

        <div class="cfg-content" id="viewConfigureTabContent">
            <div id="llmsTabContent" role="tabpanel" aria-labelledby="llms-tab-btn">
                {{> llms-config}}
            </div>
            <div id="workflowsTabContent" role="tabpanel" aria-labelledby="workflows-tab-btn" style="display:none;">
                {{> api-flows}}
            </div>
        </div>
    </div>
</div>

{{> alert}}

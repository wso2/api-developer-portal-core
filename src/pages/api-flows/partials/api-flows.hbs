<script type="application/json" id="apiFlowsDataContainer">
{{{ json apiFlows }}}
</script>

<script type="application/json" id="apiFlowsContextData">
{
    "orgID": "{{orgID}}",
    "viewName": "{{viewName}}",
    "csrfToken": "{{csrfToken}}"
}
</script>

<section id="apiFlowSection">

    {{!-- ── LIST VIEW ── --}}
    <div id="apiFlowList">
        <!-- Header -->
        {{!-- Upstream's settings panel heading, so this tab and LLM Instructions share one
              type scale and one primary action. The create button keeps its id - it is
              api-flows.js's contract - and stays behind the length check, because an empty
              list already offers the same action in its own empty state below. --}}
        <div class="cfg-panel-header">
            <div>
                <h2 class="cfg-panel-title">API Workflows</h2>
                <p class="cfg-panel-desc">Encode your real-world API use cases as guided workflows, so AI agents know
                    exactly how your APIs work together, in the right order, for the right purpose. No guesswork, no
                    hallucinations.</p>
            </div>
            {{!-- Always shown, as upstream's is. It used to be hidden when the list was
                  empty because the card grid's empty state carried its own CTA; the table's
                  empty row points at this button instead, so hiding it would leave no way
                  to create the first workflow. --}}
            <button type="button" class="cfg-btn-primary" id="createApiFlowBtn">
                <i class="bi bi-plus"></i> Add workflow
            </button>
        </div>

        {{!-- Upstream's cfg-table, replacing the card grid. Same data and the same
              endpoints - the handler hooks are unchanged (api-flow-view-prompt-btn,
              api-flow-edit-btn, api-flow-delete-btn, each carrying data-api-flow-id), so
              api-flows.js needed no change beyond the dropdown toggle. The row actions
              live in a kebab menu as upstream has them, which is what lets a row stay one
              line however many actions it grows. --}}
        <div class="cfg-table-wrap">
            <table class="cfg-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Type</th>
                        <th>Visibility</th>
                        <th style="width:52px;"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each apiFlows}}
                    <tr>
                        <td>
                            <div class="cfg-api-cell">
                                <span class="cfg-api-avatar cfg-api-avatar--workflow">{{firstTwoLetters this.name}}</span>
                                <div>
                                    <div class="cfg-cell-name">{{this.name}}</div>
                                    {{#if this.description}}
                                    <div class="cfg-cell-context" title="{{this.description}}">{{this.description}}</div>
                                    {{/if}}
                                </div>
                            </div>
                        </td>
                        <td>
                            {{#if (eq this.status "PUBLISHED")}}
                            <span class="cfg-status-badge cfg-status-published"><span class="cfg-status-dot"></span>Published</span>
                            {{else if (eq this.status "DEPRECATED")}}
                            <span class="cfg-status-badge cfg-status-deprecated"><span class="cfg-status-dot"></span>Deprecated</span>
                            {{else}}
                            <span class="cfg-status-badge cfg-status-draft"><span class="cfg-status-dot"></span>Draft</span>
                            {{/if}}
                        </td>
                        <td><span class="cfg-name-chip">{{this.contentType}}</span></td>
                        <td>
                            {{!-- Ours, not upstream's: the portal/agent visibility pair the card
                                  footer showed. Dropping them would lose information the table
                                  is otherwise carrying no worse than the cards did. --}}
                            <span class="api-flow-visibility-badge {{#if (eq this.visibility "PRIVATE")}}api-flow-visibility-private{{else}}api-flow-visibility-public{{/if}}"
                                title="{{#if (eq this.visibility "PRIVATE")}}Only logged-in users can view this workflow{{else}}Visible to all visitors{{/if}}">
                                {{#if (eq this.visibility "PRIVATE")}}<i class="bi bi-lock-fill"></i> Private{{else}}<i class="bi bi-globe"></i> Public{{/if}}
                            </span>
                            {{#unless (eq this.agentVisibility "HIDDEN")}}
                            <span class="api-flow-visibility-badge api-flow-agent-visible"
                                title="AI agents can discover and use this workflow">
                                <span class="agent-live-dot"></span><i class="bi bi-robot"></i> AI Ready
                            </span>
                            {{/unless}}
                        </td>
                        <td class="cfg-cell-actions">
                            <button class="cfg-action-btn cfg-menu-trigger" type="button" aria-label="Workflow actions">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <div class="cfg-dropdown">
                                {{#unless (eq this.agentVisibility "HIDDEN")}}
                                <button class="cfg-dropdown-item api-flow-view-prompt-btn" type="button" data-api-flow-id="{{this.apiFlowId}}">
                                    <i class="bi bi-robot"></i> View agent prompt
                                </button>
                                {{/unless}}
                                <button class="cfg-dropdown-item api-flow-edit-btn" type="button" data-api-flow-id="{{this.apiFlowId}}">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <div class="cfg-dropdown-divider"></div>
                                <button class="cfg-dropdown-item cfg-dropdown-item--danger api-flow-delete-btn" type="button" data-api-flow-id="{{this.apiFlowId}}">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                    {{/each}}
                    {{#unless apiFlows.length}}
                    <tr><td colspan="5" class="cfg-empty-row">No API Workflows yet. Click <strong>Add workflow</strong> to get started.</td></tr>
                    {{/unless}}
                </tbody>
            </table>
        </div>
    </div>

    {{!-- ── CREATE / EDIT PANEL ── --}}
    <div id="apiFlowForm" style="display:none;">
        {{> create-api-flow}}
    </div>

</section>

{{!-- ── DELETE CONFIRMATION MODAL ── --}}
<div class="modal fade" id="deleteApiFlowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteApiFlowModalTitle"></h5>
            </div>
            <div class="modal-body">
                <p id="deleteApiFlowModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn common-btn-link" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn common-btn-primary common-btn-danger" id="deleteApiFlowConfirmBtn" data-cyid="confirm">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

{{!-- ── AGENT PROMPT MODAL ── --}}
{{!-- The hero-modal treatment every other agent-prompt dialog uses - api-landing and
      mcp-landing's "Try with AI", and the home page's Discover dialog - so the one reached
      from a workflow's bot icon stops looking like a different product.

      Ids are api-flows.js's contract and unchanged: agentPromptModal, agentPromptFlowName,
      downloadPromptBtn, copyPromptBtn, runInClaudeBtn, agentPromptContent. The copy button
      keeps a single <i>: the handler swaps that icon's own class (api-flows.js:1600), which
      the copy-btn span pair used elsewhere would break. --}}
<div class="modal fade" id="agentPromptModal" tabindex="-1" aria-labelledby="agentPromptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content hero-modal">

            <div class="hero-modal-header">
                <div class="hero-modal-title-row">
                    <span class="hero-modal-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                    <h2 class="hero-modal-title" id="agentPromptModalLabel">Try with AI agent</h2>
                </div>
                <button type="button" class="hero-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="hero-modal-info">
                <p class="hero-modal-info-text">Use this prompt to let your AI agent run
                    <strong id="agentPromptFlowName"></strong> &mdash; handling the API calls,
                    dependencies and errors automatically.</p>
                <button type="button" class="hero-run-btn" id="runInClaudeBtn">
                    <i class="bi bi-play-fill" aria-hidden="true"></i> Run in Claude
                </button>
            </div>

            <div class="modal-body hero-modal-body">
                <div class="hero-prompt-card">
                    <div class="hero-prompt-actions">
                        <button type="button" class="hero-prompt-tool" id="downloadPromptBtn" title="Download as .txt">
                            <i class="bi bi-download"></i>
                        </button>
                        <button type="button" class="hero-prompt-tool" id="copyPromptBtn" title="Copy prompt">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                    <pre id="agentPromptContent" class="hero-prompt-pre"></pre>
                </div>
            </div>

        </div>
    </div>
</div>

{{!-- Hero. One section, edge to edge; the catalogue lives a click away.
     The artefact wording comes from the artifactTypesLabel helper, which composes it
     from devportalMode and showApiWorkflowsNav - six combinations that would otherwise
     need a branch each, twice over. --}}
<section class="hero" aria-label="Portal hero">
  <div class="hero-particles" id="hero-particles" aria-hidden="true"></div>

  <div class="hero-hero-body">
    <span class="hero-pill">
      <i class="bi bi-stars" aria-hidden="true"></i>
      {{#if showApiWorkflowsNav}}Ready for AI agents{{else}}Ready for developers{{/if}}
    </span>

    <h1 class="hero-headline">
      <span class="hero-headline-accent">{{artifactTypesLabel devportalMode showApiWorkflowsNav}}</span><br>built for Developers{{#if showApiWorkflowsNav}} and AI Agents{{/if}}.
    </h1>

    <p class="hero-desc">
      Discover, connect, and orchestrate {{artifactTypesLabel devportalMode showApiWorkflowsNav}}. Browse the catalog, subscribe, and get going in minutes.
    </p>

    <div class="hero-ctas">
      {{#in devportalMode values="DEFAULT,APISONLY"}}
      <a href="{{baseUrl}}/apis" class="hero-btn hero-btn--gradient">
        Browse our APIs <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#in devportalMode values="DEFAULT,MCPSERVERSONLY"}}
      <a href="{{baseUrl}}/mcps" class="hero-btn hero-btn--gradient">
        Browse our MCP servers <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#if showApiWorkflowsNav}}
      <button type="button" class="hero-btn hero-btn--ai discover-ai-btn" data-bs-toggle="modal" data-bs-target="#discoverAiModal">
        <i class="bi bi-stars" aria-hidden="true"></i> Discover with AI
      </button>
      {{/if}}
    </div>
  </div>
</section>

{{#if showApiWorkflowsNav}}
{{!-- The hero-modal treatment every other AI prompt dialog in the portal uses.
      agent-prompt.css is already linked by home/page.hbs, so this needs no new CSS.

      Ids are home-discover.js's contract and are unchanged: discoverAiModal,
      discoverBtnRunClaude, discoverBtnDownloadPrompt, discoverBtnCopyPrompt and
      discoverPromptText. The copy button keeps a single <i> because that handler swaps the
      icon's own class (home-discover.js:41), which the copy-btn span pair would break. --}}
<div class="modal fade" id="discoverAiModal" tabindex="-1" aria-labelledby="discoverAiModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content hero-modal">

            <div class="hero-modal-header">
                <div class="hero-modal-title-row">
                    <span class="hero-modal-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                    <h2 class="hero-modal-title" id="discoverAiModalLabel">Discover with AI agents</h2>
                </div>
                <button type="button" class="hero-modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="hero-modal-info">
                <p class="hero-modal-info-text">Use this prompt to let your AI agent explore and discover what's available in this portal.</p>
                <button type="button" class="hero-run-btn" id="discoverBtnRunClaude">
                    <i class="bi bi-play-fill" aria-hidden="true"></i> Run in Claude
                </button>
            </div>

            <div class="modal-body hero-modal-body">
                <div class="hero-prompt-card">
                    <div class="hero-prompt-actions">
                        <button type="button" class="hero-prompt-tool" id="discoverBtnDownloadPrompt" title="Download as .txt">
                            <i class="bi bi-download"></i>
                        </button>
                        <button type="button" class="hero-prompt-tool" id="discoverBtnCopyPrompt" title="Copy prompt">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                    <pre id="discoverPromptText" class="hero-prompt-pre"></pre>
                </div>
            </div>

        </div>
    </div>
</div>
{{/if}}

<script src='/technical-scripts/home-particles.js' defer></script>

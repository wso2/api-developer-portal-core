{{!-- Hero. One section, edge to edge; the catalogue lives a click away.
     devportalMode drives the wording: DEFAULT covers both artefact types,
     APISONLY and MCPSERVERSONLY each name only their own. --}}
<section class="hero" aria-label="Portal hero">
  <div class="hero-hero-body">
    <span class="hero-pill">
      <i class="bi bi-stars" aria-hidden="true"></i>
      {{#if showApiWorkflowsNav}}Ready for AI agents{{else}}Ready for developers{{/if}}
    </span>

    <h1 class="hero-headline">
      {{#if (eq devportalMode "MCPSERVERSONLY")}}
      <span class="hero-headline-accent">MCP Servers</span><br>built for Developers{{#if showApiWorkflowsNav}} and AI Agents{{/if}}.
      {{else if (eq devportalMode "APISONLY")}}
      <span class="hero-headline-accent">APIs</span><br>built for Developers{{#if showApiWorkflowsNav}} and AI Agents{{/if}}.
      {{else}}
      <span class="hero-headline-accent">APIs &amp; MCP Servers</span><br>built for Developers{{#if showApiWorkflowsNav}} and AI Agents{{/if}}.
      {{/if}}
    </h1>

    <p class="hero-desc">
      {{#if (eq devportalMode "MCPSERVERSONLY")}}
      Discover, connect, and orchestrate MCP servers. Browse the catalog, subscribe, and get going in minutes.
      {{else if (eq devportalMode "APISONLY")}}
      Discover, connect, and orchestrate APIs. Browse the catalog, subscribe, and get going in minutes.
      {{else}}
      Discover, connect, and orchestrate APIs and MCP servers. Browse the catalog, subscribe, and get going in minutes.
      {{/if}}
    </p>

    <div class="hero-ctas">
      {{#in devportalMode values="DEFAULT,APISONLY"}}
      <a href="{{baseUrl}}/apis" class="hero-btn hero-btn--gradient">
        Browse our APIs <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#in devportalMode values="DEFAULT,MCPSERVERSONLY"}}
      <a href="{{baseUrl}}/mcps" class="hero-btn hero-btn--gradient">
        Browse our MCP servers <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
      {{/in}}
      {{#if showApiWorkflowsNav}}
      <button type="button" class="hero-btn hero-btn--ai discover-ai-btn" data-bs-toggle="modal" data-bs-target="#discoverAiModal">
        <i class="bi bi-stars" aria-hidden="true"></i> Discover with AI
      </button>
      {{/if}}
    </div>
  </div>
</section>

{{#if showApiWorkflowsNav}}
<div class="modal fade" id="discoverAiModal" tabindex="-1" aria-labelledby="discoverAiModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="modal-title mb-0" id="discoverAiModalLabel">Discover with AI Agents</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="api-flow-prompt-toolbar">
                    <span class="small text-muted">Use this prompt to let your AI agent explore and discover what's available in this portal</span>
                    <div class="prompt-modal-toolbar">
                        <button type="button" class="btn-run-prompt" id="discoverBtnRunClaude">
                            <i class="bi bi-play-fill"></i> Run in Claude
                        </button>
                    </div>
                </div>
                <div class="api-flow-prompt-pre-wrapper">
                    <div class="prompt-pre-actions">
                        <button type="button" class="prompt-tool-btn" id="discoverBtnDownloadPrompt" title="Download as .txt">
                            <i class="bi bi-download"></i>
                        </button>
                        <button type="button" class="prompt-tool-btn" id="discoverBtnCopyPrompt" title="Copy prompt">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                    <pre id="discoverPromptText" class="api-flow-prompt-pre"></pre>
                </div>
            </div>
        </div>
    </div>
</div>
{{/if}}

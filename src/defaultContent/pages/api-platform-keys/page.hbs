<head>
  <link rel='stylesheet' href='/technical-styles/subscriptions.css' />
  <link rel='stylesheet' href='/technical-styles/platform-api-keys.css' />
  <script src='/technical-scripts/platform-api-keys-page.js' defer></script>
</head>
<main>
    {{> header profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav }}
    {{> sidebar profile=profile baseUrl=baseUrl devportalMode=devportalMode showPlatformApiKeysNav=showPlatformApiKeysNav showApiWorkflowsNav=showApiWorkflowsNav }}
    <div class="content">
        <div class="container-fluid subscriptions-container platform-api-keys-page">
            {{!-- Upstream's page header: .page-title with a description beside a gradient
                  dp-btn, in place of .container-header's 1.5rem/600 --primary span and the
                  flat navy common-btn-primary. All three classes already ship in
                  components.css - this page was the only one still on the old pairing. --}}
            <div class="page-header mb-4 d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <h1 class="page-title">API Keys</h1>
                    <p class="page-desc">API keys authenticate requests to this API. Generate a key, then send it as the
                        <code class="ak-inline-code">apikey</code> header.</p>
                </div>
                {{#unless isReadOnlyMode}}
                {{#unless platformApiKeysLoadError}}
                <button type="button" class="dp-btn dp-btn--primary" id="btn-open-generate-api-key" data-bs-toggle="modal" data-bs-target="#generatePlatformApiKeyModal">
                    <i class="bi bi-plus"></i> Generate API key
                </button>
                {{/unless}}
                {{/unless}}
            </div>
            <div id="platform-api-keys-config" class="d-none"
                data-org-id="{{orgID}}"
                data-api-id="{{apiMetadata.apiID}}"
                data-read-only="{{#if isReadOnlyMode}}true{{else}}false{{/if}}"
                data-load-error="{{#if platformApiKeysLoadError}}true{{else}}false{{/if}}"
                data-csrf-token="{{csrfToken}}">
            </div>
            {{> platform-api-key-list }}
        </div>
    </div>
    {{> alert }}
    {{!-- Revoking is irreversible, so it asks first. This page rendered only the
          alert partial, so the shared confirm dialog was not on the page and the
          revoke handler fell back to a native confirm(). --}}
    {{> warning modalTitle="Confirm" modalMessage="" modalFunction="" }}
</main>

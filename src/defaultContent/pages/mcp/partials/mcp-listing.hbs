<section class="apis-section">
  <div class="container-fluid">
    <div class="apilist-hero-container">
      <div class="apilist-hero-content">
        <div class="apilist-hero-header">
          <h1 class="apilist-hero-title">
            Discover, integrate, and innovate with MCP-powered tools for your agents.
          </h1>
          <div class="apilist-hero-description">
            Explore our extensive MCP catalog and discover how to integrate them seamlessly into your application.
          </div>
        </div>
      </div>
      <div class="col-lg-6 col-md-12 apilist-hero-image">
        <img
          src="/images/mcphero.svg"
          alt="Hero Image" class="img-fluid" style="max-width: 65%;"/>
      </div>
    </div>
  </div>
  <div class="container-fluid apilist-container">
    <div class="search-container">
      <div class="search-input">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="query" placeholder="Search MCP Servers" autocomplete="off" />
      </div>
    </div>
    {{!-- Type-aware for the same reason as the API listing: this page is served the
          combined API + MCP list and shows only MCP servers, so apiMetadata.length would
          count both catalogues. --}}
    {{#if (eq (countWhere apiMetadata "apiInfo.apiType" "MCP" true) 0)}}
    <div class="apilist-empty" id="no-subscription">
      <div class="apilist-empty-icon">
        <i class="bi bi-info-circle"></i>
      </div>
      <div class="apilist-empty-body">
        <div class="apilist-empty-title">No MCP servers available yet</div>
        <p class="apilist-empty-desc">There are no published MCP servers in this Portal right now. Once MCP servers are published, they'll appear here for you to explore and subscribe to.</p>
      </div>
    </div>
    {{else}}
    <div class="apilist-results-bar">
      <h2 class="apilist-results-heading">MCP Servers <span class="apilist-results-count">{{countWhere apiMetadata "apiInfo.apiType" "MCP" true}}</span></h2>
    </div>
    {{/if}}

    <div class="row row-gap-4">
      {{#apiMetadata}}
      {{#if (eq apiInfo.apiType "MCP")}}
      <div class="col-lg-4 col-md-6 col-sm-12" id="apiCard-{{apiID}}">
        {{!-- Same card as the API listing, and carrying no subscribed state for the same
              reason: which plans are held belongs on the server's own page, per plan. --}}
        <div class="api-card d-flex flex-column">

          {{!-- This page has no click-delegation script, so navigation stays on inline
                handlers rather than the data-href the API listing uses. --}}
          <div class="api-card-top" onclick="window.location.href='{{../baseUrl}}/mcp/{{apiHandle}}'" style="cursor:pointer;">
            {{#if apiInfo.apiImageMetadata.api-icon}}
            <img src="{{apiInfo.apiImageMetadata.api-icon}}" class="api-card-img" alt="{{or apiInfo.apiTitle apiInfo.apiName}}" />
            {{else}}
            <span class="api-icon api-icon--mcp">{{firstTwoLetters (or apiInfo.apiTitle apiInfo.apiName)}}</span>
            {{/if}}
            <div class="api-card-meta">
              <h5 class="api-card-title">{{or apiInfo.apiTitle apiInfo.apiName}}</h5>
              <div class="api-card-meta-row">
                <span class="api-version">{{apiInfo.apiVersion}}</span>
                <span class="dp-badge dp-badge--mcp">
                  <img src="/images/mcp-icon.svg" class="dp-badge-icon" alt="" /> MCP
                </span>
              </div>
            </div>
          </div>

          <p class="api-card-desc clamp2" onclick="window.location.href='{{../baseUrl}}/mcp/{{apiHandle}}'" style="cursor:pointer;">{{apiInfo.apiDescription}}</p>

          <div class="api-card-tags">
            {{#apiInfo.tags}}
            <span class="dp-tag">{{this}}</span>
            {{/apiInfo.tags}}
          </div>

          {{#if subscriptionPolicies.length}}
          <div class="api-card-footer">
            <div class="api-card-footer-left">
              <a href="{{../baseUrl}}/mcp/{{apiHandle}}#subscriptionPlans" class="api-plans-link">
                <i class="bi bi-tag"></i> {{subscriptionPolicies.length}} {{conditionalIf (eq subscriptionPolicies.length 1) "plan" "plans"}}
              </a>
            </div>
            {{!-- Subscribing happens on the MCP server's own page, as upstream does it.
                  #subscriptionPlans there is rendered by mcp-landing/page.hbs and carries
                  the plan list, the application picker and the read-only guard, so the
                  per-card modal is no longer built here. --}}
            {{#if ../isAuthenticated}}
            <a href="{{../baseUrl}}/mcp/{{apiHandle}}#subscriptionPlans" class="dp-btn dp-btn--primary">Subscribe</a>
            {{/if}}
          </div>
          {{/if}}

          <div class="message-overlay hidden">
            <div class="message-content">
              <i class="bi message-icon"></i>
              <p class="message-text"></p>
            </div>
            <button type="button" class="close-message" aria-label="Close message">&times;</button>
          </div>
        </div>
      </div>
      {{/if}}
      {{/apiMetadata}}
    </div>
  </div>

  {{!-- paginate.js targets ".apilist-container .row.row-gap-4", which this page has too -
        its own comment covers "public card grids (/apis and /mcps)". Already allowlisted
        for the API listing; it no-ops when the grid is empty. --}}
  <script src='/technical-scripts/paginate.js' defer></script>
</section>

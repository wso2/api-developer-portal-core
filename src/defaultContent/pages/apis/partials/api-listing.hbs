<section class="apis-section">
  <div class="container-fluid">
    {{!-- Hero. The illustration is inline SVG rather than apisHeroImg.png: it recolours
          with the theme and costs no request. --}}
    <div class="apilist-hero-container">
      <div class="apilist-hero-content">
        <h1 class="apilist-hero-title">Discover, Integrate, and Innovate with Scalable APIs</h1>
        <p class="apilist-hero-description">Explore our extensive API catalog and discover how to integrate them seamlessly into your application.</p>
      </div>
      <div class="apilist-hero-image">
        <svg width="280" height="150" viewBox="0 0 320 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M82 62 H128" stroke="#a9c1e6" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>
          <path d="M192 128 H238" stroke="#a9c1e6" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>
          <path d="M160 96 V62 H128" stroke="#a9c1e6" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>
          <rect x="120" y="44" width="120" height="104" rx="16" fill="#dbe7f8" stroke="#9db8e0" stroke-width="2"/>
          <rect x="138" y="66" width="84" height="11" rx="5.5" fill="var(--white)"/>
          <rect x="138" y="90" width="66" height="8" rx="4" fill="#b6caea"/>
          <rect x="138" y="108" width="78" height="8" rx="4" fill="#b6caea"/>
          <rect x="138" y="126" width="50" height="8" rx="4" fill="#b6caea"/>
          <circle cx="56" cy="62" r="27" fill="#c7d8f3" stroke="#8fa9d6" stroke-width="2"/>
          <circle cx="56" cy="62" r="6" fill="#5b7fb9"/>
          <circle cx="266" cy="128" r="27" fill="#5b7fb9"/>
          <rect x="256" y="125" width="20" height="15" rx="3" fill="var(--white)"/>
          <path d="M259 125 v-3.5 a7 7 0 0 1 14 0 V125" stroke="var(--white)" stroke-width="2.4" fill="none"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="container-fluid apilist-container">
    <div class="search-container">
      <div class="search-input">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="query" placeholder="Search APIs" autocomplete="off" />
      </div>
    </div>

    {{!-- Counted with countWhere, not apiMetadata.length: this route and /mcps are served
          the same list and each grid filters by type in the markup, so the raw length is
          both catalogues combined. An org holding only MCP servers would otherwise show
          an empty grid and no empty state. --}}
    {{#if (eq (countWhere apiMetadata "apiInfo.apiType" "MCP" false) 0)}}
    <div class="apilist-empty" id="no-subscription">
      <div class="apilist-empty-icon">
        <i class="bi bi-info-circle"></i>
      </div>
      <div class="apilist-empty-body">
        <div class="apilist-empty-title">No APIs available yet</div>
        <p class="apilist-empty-desc">There are no published APIs in this API Portal right now. Once APIs are published, they'll appear here for you to explore and subscribe to.</p>
      </div>
    </div>
    {{else}}
    <div class="apilist-results-bar">
      <h2 class="apilist-results-heading">APIs <span class="apilist-results-count">{{countWhere apiMetadata "apiInfo.apiType" "MCP" false}}</span></h2>
    </div>
    {{/if}}

    <div class="row row-gap-4">

      {{#apiMetadata}}
      {{!-- MCP servers have their own listing; this grid is API proxies only. --}}
      {{#unless (eq apiInfo.apiType "MCP")}}
      <div class="col-lg-4 col-md-6 col-sm-12" id="apiCard-{{apiID}}">
        {{!-- Subscribed state. A platform gateway and a token-based subscription both
              report through hasPlatformSubscription; everything else reports through the
              application list. The same split governs the ribbon and the footer button. --}}
        <div class="api-card d-flex flex-column{{#if ../isAuthenticated}}{{#if (or apiInfo.tokenBasedSubscriptionEnabled (eq apiInfo.gatewayType "wso2/api-platform"))}}{{#if hasPlatformSubscription}} api-card--subscribed{{/if}}{{else}}{{#if (some applications "subscribed")}} api-card--subscribed{{/if}}{{/if}}{{/if}}">

          {{#if ../isAuthenticated}}
          {{#if (or apiInfo.tokenBasedSubscriptionEnabled (eq apiInfo.gatewayType "wso2/api-platform"))}}
          {{#if hasPlatformSubscription}}<div class="api-card-ribbon-wrap"><div class="api-card-ribbon-label">Subscribed</div></div>{{/if}}
          {{else}}
          {{#if (some applications "subscribed")}}<div class="api-card-ribbon-wrap"><div class="api-card-ribbon-label">Subscribed</div></div>{{/if}}
          {{/if}}
          {{/if}}

          <div class="api-card-top" data-href="{{../baseUrl}}/api/{{apiHandle}}" style="cursor:pointer;">
            {{#if apiInfo.apiImageMetadata.api-icon}}
            <img src="{{apiInfo.apiImageMetadata.api-icon}}" class="api-card-img" alt="{{apiInfo.apiName}}" />
            {{else}}
            <span class="api-icon
              {{#if (eq apiInfo.apiType "GRAPHQL")}}api-icon--graphql
              {{else if (eq apiInfo.apiType "WS")}}api-icon--ws
              {{else if (eq apiInfo.apiType "WEBSUB")}}api-icon--ws
              {{else if (eq apiInfo.apiType "SOAP")}}api-icon--soap
              {{else}}api-icon--rest{{/if}}">{{firstTwoLetters apiInfo.apiName}}</span>
            {{/if}}
            <div class="api-card-meta">
              <h5 class="api-card-title">{{apiInfo.apiName}}</h5>
              <div class="api-card-meta-row">
                <span class="api-version">{{apiInfo.apiVersion}}</span>
                <span class="dp-badge
                  {{#if (eq apiInfo.apiType "GRAPHQL")}}dp-badge--graphql
                  {{else if (eq apiInfo.apiType "WS")}}dp-badge--ws
                  {{else if (eq apiInfo.apiType "WEBSUB")}}dp-badge--ws
                  {{else if (eq apiInfo.apiType "SOAP")}}dp-badge--soap
                  {{else}}dp-badge--rest{{/if}}">
                  {{#if (eq apiInfo.apiType "GRAPHQL")}}<img src="/images/graphql-icon.svg" class="dp-badge-icon" alt="" /> GraphQL
                  {{else if (eq apiInfo.apiType "WS")}}<img src="/images/websocket-icon.svg" class="dp-badge-icon" alt="" /> WebSocket
                  {{else if (eq apiInfo.apiType "WEBSUB")}}<i class="bi bi-broadcast-pin"></i> WebSub
                  {{else if (eq apiInfo.apiType "SOAP")}}<i class="bi bi-file-code"></i> SOAP
                  {{else}}<i class="bi bi-braces"></i> REST{{/if}}
                </span>
                {{#if ../showApiWorkflowsNav}}
                {{#unless (eq apiInfo.agentVisibility "HIDDEN")}}
                <span class="dp-badge dp-badge--ai" title="AI agents can discover and use this API">
                  <i class="bi bi-robot"></i> AI Ready
                </span>
                {{/unless}}
                {{/if}}
                {{#if (eq apiInfo.apiStatus "DEPRECATED")}}
                <span class="dp-badge dp-badge--deprecated"><i class="bi bi-exclamation-circle"></i> Deprecated</span>
                {{/if}}
              </div>
            </div>
          </div>

          <p class="api-card-desc clamp2" data-href="{{../baseUrl}}/api/{{apiHandle}}" style="cursor:pointer;">{{apiInfo.apiDescription}}</p>

          <div class="api-card-tags">
            {{#apiInfo.tags}}
            <span class="dp-tag">{{this}}</span>
            {{/apiInfo.tags}}
          </div>

          {{!-- Footer shows whenever the API offers plans - the count is public
                information, as upstream treats it. Only the subscribe control below is
                gated on being signed in. --}}
          {{#if subscriptionPolicies.length}}
          <div class="api-card-footer">
            <div class="api-card-footer-left">
              <a href="{{../baseUrl}}/api/{{apiHandle}}#subscriptionPlans" class="api-plans-link">
                <i class="bi bi-tag"></i> {{subscriptionPolicies.length}} {{conditionalIf (eq subscriptionPolicies.length 1) "plan" "plans"}}
              </a>
            </div>
            {{!-- The subscribe control sits as a direct child of the footer, the way
                  upstream has it, so .api-card-footer's space-between puts it opposite the
                  plans link. It used to be wrapped in .subscription-container, which the
                  old full-width-button card styled `width: 100%` with negative vertical
                  margins - inside a space-between row that stretched across the footer and
                  threw the button out of alignment. No script references the wrapper.
                  Each branch keeps its own modal partial: the modal carries the plan list
                  and the application picker, so dropping it would break subscribing from
                  the listing. It renders display:none, so it adds nothing to the row. --}}
            {{#if ../isAuthenticated}}
              {{#if apiInfo.tokenBasedSubscriptionEnabled}}
                {{> subscription-modal apiID=apiID apiInfo=apiInfo apiReferenceID=apiReferenceID}}
                {{#if hasPlatformSubscription}}
                <a href="{{../baseUrl}}/api/{{apiHandle}}#subscriptionPlans" class="api-card-view-sub-btn">
                  <i class="bi bi-check-circle"></i> View subscription
                </a>
                {{else}}
                <a type="button" class="dp-btn dp-btn--primary open-modal-btn {{#if @root.isReadOnlyMode}}is-readonly{{/if}}"
                  {{#unless @root.isReadOnlyMode}}data-modal="planModal-{{apiID}}"{{/unless}}
                  {{#if @root.isReadOnlyMode}}aria-disabled="true"{{/if}}>Subscribe</a>
                {{/if}}
              {{else if (eq apiInfo.gatewayType "wso2/api-platform")}}
                {{#if subscriptionPolicies.length}}
                {{> subscription-modal apiID=apiID apiInfo=apiInfo apiReferenceID=apiReferenceID}}
                {{#if hasPlatformSubscription}}
                <a href="{{../baseUrl}}/api/{{apiHandle}}#subscriptionPlans" class="api-card-view-sub-btn">
                  <i class="bi bi-check-circle"></i> View subscription
                </a>
                {{else}}
                <a type="button" class="dp-btn dp-btn--primary open-modal-btn {{#if @root.isReadOnlyMode}}is-readonly{{/if}}"
                  {{#unless @root.isReadOnlyMode}}data-modal="planModal-{{apiID}}"{{/unless}}
                  {{#if @root.isReadOnlyMode}}aria-disabled="true"{{/if}}>Subscribe</a>
                {{/if}}
                {{/if}}
              {{else}}
                {{> subscription-plans apiInfo=apiInfo apiName=apiInfo.apiName}}
                {{#if subscriptionPolicies.length}}
                {{#if (some applications "subscribed")}}
                <a href="{{../baseUrl}}/api/{{apiHandle}}#subscriptionPlans" class="api-card-view-sub-btn">
                  <i class="bi bi-check-circle"></i> View subscription
                </a>
                {{else}}
                <a type="button" class="dp-btn dp-btn--primary open-modal-btn {{#if @root.isReadOnlyMode}}is-readonly{{/if}}"
                  {{#unless @root.isReadOnlyMode}}data-modal="planModal-{{apiID}}"{{/unless}}
                  {{#if @root.isReadOnlyMode}}aria-disabled="true"{{/if}}>Subscribe</a>
                {{/if}}
                {{/if}}
              {{/if}}
            {{/if}}
          </div>
          {{/if}}

          <div class="message-overlay hidden">
            <div class="message-content">
              <i class="bi message-icon"></i>
              <p class="message-text"></p>
            </div>
            <button type="button" class="close-message" aria-label="Close message">&times;</button>
          </div>
        </div>
      </div>
      {{/unless}}
      {{/apiMetadata}}
    </div>
  </div>
  <script>
    (function(){
      function findClosest(el, selector){
        while(el && el !== document){
          if(el.matches && el.matches(selector)) return el;
          el = el.parentNode;
        }
        return null;
      }

      document.addEventListener('click', function(e){
        var modalTrigger = findClosest(e.target, '[data-modal]');
        if(modalTrigger){
          e.preventDefault();
          if(modalTrigger.classList.contains('is-readonly') || modalTrigger.getAttribute('aria-disabled') === 'true'){
            return;
          }
          if(typeof loadModal === 'function'){
            loadModal(modalTrigger.getAttribute('data-modal'));
          } else {
            var id = modalTrigger.getAttribute('data-modal');
            var el = document.getElementById(id);
            if(el) {
              el.style.display = 'flex';
              document.body.classList.add('modal-open');
              if(typeof prepareSubscriptionModal === 'function') {
                try { prepareSubscriptionModal(id); } catch(err) { /* noop */ }
              }
            }
          }
          return;
        }

        var nav = findClosest(e.target, '[data-href]');
        if(nav){
          var href = nav.getAttribute('data-href');
          if(href){ window.location.href = href; }
        }
      }, false);
    })();
  </script>

  {{!-- Paginates the card grid. The .dp-pagination rules have been in components.css
        since the component layer was ported but nothing rendered them, so long
        catalogues ran as one unbounded scroll. The script mounts its own control after
        the grid and no-ops when the grid is empty. --}}
  <script src='/technical-scripts/paginate.js' defer></script>
</section>

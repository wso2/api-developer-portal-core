{{!-- The empty state is always in the DOM, hidden while rows exist. subscriptions-page.js
      removes the last row's table container and then unhides this by id, so rendering it
      only in the {{else}} branch would leave the page blank after the final unsubscribe. --}}
<div class="dp-empty" id="no-subscriptions" {{#if subscriptions.length}}style="display:none;"{{/if}}>
    <span class="dp-empty-icon">
        <i class="bi bi-inbox"></i>
    </span>
    <h2 class="dp-empty-title">No subscriptions yet</h2>
    <p class="dp-empty-desc">Subscribe an application to an API or MCP server to start making calls. Your active subscriptions will show up here. Browse <a href="{{baseUrl}}/apis">APIs</a> to get started.</p>
</div>
{{#if subscriptions.length}}
<div class="sub-scroll table-responsive">
    <div class="sub-tablewrap">
            <script>
                window.__tokenMap = window.__tokenMap || {};
                window.__subscriptionOrgID = "{{@root.orgID}}";
            </script>
        <table class="sub-table" id="subscriptions-table">
            <thead>
                <tr>
                    <th>API</th>
                    <th>Version</th>
                    <th>Type</th>
                    <th>Plan</th>
                    <th>Application</th>
                    <th>Status</th>
                    <th>Subscription Token</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each subscriptions}}
                <tr id="sub-row-{{this.id}}"
                    data-sub-id="{{this.id}}"
                    data-api-name="{{this.apiName}}"
                    data-plan-name="{{this.planName}}"
                    data-status="{{this.status}}">
                    <td>
                        <a class="sub-api-link" href="{{../baseUrl}}/api/{{this.apiHandle}}">{{this.apiName}}</a>
                    </td>
                    <td>{{this.apiVersion}}</td>
                    <td>
                        {{#if (eq this.type 'TOKEN_BASED')}}
                        <span class="sub-type-pill">Token-based</span>
                        {{else}}
                        <span class="sub-type-pill sub-type-pill--app">App-based</span>
                        {{/if}}
                    </td>
                    <td>{{this.planName}}</td>
                    <td>
                        {{#if this.applicationName}}
                        {{this.applicationName}}
                        {{else}}
                        <span class="text-muted">&mdash;</span>
                        {{/if}}
                    </td>
                    <td>
                        {{!-- An app-based subscription has no lifecycle of its own; it exists
                              only while the application is subscribed, so it always reads
                              active. --}}
                        {{#if (eq this.type 'TOKEN_BASED')}}
                        <span class="sub-status-pill {{#if (eq this.status 'ACTIVE')}}sub-status-pill--active{{else}}sub-status-pill--inactive{{/if}}">
                            <span class="sub-status-dot"></span>
                            {{this.status}}
                        </span>
                        {{else}}
                        <span class="sub-status-pill sub-status-pill--active">
                            <span class="sub-status-dot"></span>
                            ACTIVE
                        </span>
                        {{/if}}
                    </td>
                    <td>
                        {{#if (eq this.type 'TOKEN_BASED')}}
                        <div class="token-display d-flex align-items-center gap-1">
                            <code class="masked-token" id="list-token-{{this.id}}" data-revealed="false">****</code>
                            <button class="btn btn-sm btn-link p-0" onclick="toggleListTokenVisibility('{{this.id}}')" title="Reveal">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-link p-0" onclick="copySubscriptionToken('{{this.id}}')" title="Copy">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                        {{else}}
                        <span class="text-muted">&mdash;</span>
                        {{/if}}
                    </td>
                    <td>
                        <div class="sub-actions">
                            {{#if (eq this.type 'TOKEN_BASED')}}
                            <button class="sub-action-btn sub-action-btn--toggle" title="{{#if (eq this.status 'ACTIVE')}}Deactivate{{else}}Activate{{/if}}"
                                {{#unless @root.isReadOnlyMode}}onclick="toggleSubscriptionStatus('{{../orgID}}', '{{this.id}}', '{{#if (eq this.status "ACTIVE")}}INACTIVE{{else}}ACTIVE{{/if}}')"{{/unless}}
                                {{#if @root.isReadOnlyMode}}disabled{{/if}}>
                                {{#if (eq this.status 'ACTIVE')}}<i class="bi bi-pause-circle"></i>{{else}}<i class="bi bi-play-circle"></i>{{/if}}
                            </button>
                            <button class="sub-action-btn sub-action-btn--delete" title="Delete"
                                {{#unless @root.isReadOnlyMode}}onclick="prepareDeleteSubscription('{{../orgID}}', '{{this.id}}', 'TOKEN_BASED')"{{/unless}}
                                {{#if @root.isReadOnlyMode}}disabled{{/if}}>
                                <i class="bi bi-trash"></i>
                            </button>
                            {{else}}
                            <button class="sub-action-btn sub-action-btn--delete" title="Unsubscribe"
                                {{#unless @root.isReadOnlyMode}}onclick="prepareDeleteSubscription('{{../orgID}}', '{{this.id}}', 'APP_BASED', '{{this.appId}}', '{{this.apiRefId}}')"{{/unless}}
                                {{#if @root.isReadOnlyMode}}disabled{{/if}}>
                                <i class="bi bi-trash"></i>
                            </button>
                            {{/if}}
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}

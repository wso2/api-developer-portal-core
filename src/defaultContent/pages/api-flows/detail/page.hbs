<head>
    <link rel="stylesheet" href="/technical-styles/agent-prompt.css">
    <link rel="stylesheet" href="/technical-styles/api-workflows.css">
    {{#unless (eq flow.contentType "MD")}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@jentic/arazzo-ui@1.0.0-alpha.30/dist/arazzo-ui.css" integrity="sha256-WHPlCD3ecWnrluuPAx7VypEZtfvv4DrIMfdLYzLshsM=" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/@jentic/arazzo-ui@1.0.0-alpha.30/dist/arazzo-ui.js" integrity="sha256-OYzURPQLK+lup5rGo+IQmVbjWOjVgjURBWDDtMHIOaw=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js" integrity="sha256-Rdw90D3AegZwWiwpibjH9wkBPwS9U4bjJ51ORH8H69c=" crossorigin="anonymous"></script>
    {{/unless}}
    {{#if (eq flow.contentType "MD")}}
    <script src="https://cdn.jsdelivr.net/npm/marked@13.0.3/marked.min.js" integrity="sha256-Wt6n2O5BpwD8zBS7nVAxBPBHDMF6hK0+Fn0/UlHq4No=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.2.7/purify.min.js" integrity="sha512-78KH17QLT5e55GJqP76vutp1D2iAoy06WcYBXB6iBCsmO6wWzx0Qdg8EDpm8mKXv68BcvHOyeeP4wxAL0twJGQ==" crossorigin="anonymous"></script>
    {{/if}}
</head>

<main data-flow-handle="{{flow.handle}}" data-flow-content-type="{{flow.contentType}}">
    {{> header profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav}}
    {{> sidebar profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav}}

    <div class="flow-detail-section">
        {{!-- Breadcrumb, replacing the bespoke Back link - upstream's detail page carries
              one, and so does every other detail page in the portal. --}}
        <nav class="dp-breadcrumb flow-detail-breadcrumb">
            <a class="dp-breadcrumb-item" href="{{baseUrl}}/api-workflows">API Workflows</a>
            <i class="bi bi-chevron-right dp-breadcrumb-sep"></i>
            <span class="dp-breadcrumb-current">{{flow.name}}</span>
        </nav>

        {{!-- Header --}}
        <div class="flow-detail-header">
            <div class="flow-detail-header-content">
                <h1>{{flow.name}}</h1>
                <p>{{flow.description}}</p>
            </div>
            <div class="flow-header-actions">
                {{#unless (eq flow.agentVisibility "HIDDEN")}}
                {{!-- dp-btn--ai, the same treatment "Try with AI" gets on the API and MCP
                      landing pages. It was common-btn-primary here, so the identical
                      action rendered navy on this page and purple on the other two. --}}
                <button type="button" class="dp-btn dp-btn--ai" id="openPromptBtn"
                    data-bs-toggle="modal" data-bs-target="#agentPromptModal">
                    <i class="bi bi-robot"></i> Try with AI
                </button>
                {{/unless}}
            </div>
        </div>

        {{!-- Content --}}
        <div class="flow-detail-content">
            {{#if (eq flow.contentType "MD")}}
            {{!-- Markdown Preview --}}
            <div class="af-md-detail-container" id="markdownViewer"></div>
            {{else}}
            {{!-- Arazzo UI Viewer --}}
            <div class="arazzo-viewer-container">
                <div id="arazzoViewer"></div>
            </div>
            {{/if}}
        </div>
    </div>

    {{> alert}}

    {{!-- ── AGENT PROMPT MODAL ── --}}
    {{!-- The hero-modal treatment the API and MCP landing pages use for the same action.
          agent-prompt.css is already linked above, so this needs no new CSS.

          Every id is unchanged - agentPromptModal, btnRunClaude, btnDownloadPrompt,
          btnCopyPrompt, modalAgentPromptText - so api-flow-detail.js is untouched. The
          copy button deliberately keeps a single <i> rather than the landing pages'
          copy-btn-icon/copy-btn-check pair: that handler swaps the icon's className
          directly (api-flow-detail.js:120), and the two-span markup would break it. --}}
    <div class="modal fade" id="agentPromptModal" tabindex="-1" aria-labelledby="agentPromptModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content hero-modal">

                <div class="hero-modal-header">
                    <div class="hero-modal-title-row">
                        <span class="hero-modal-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
                        <h2 class="hero-modal-title" id="agentPromptModalLabel">Try with AI agent</h2>
                    </div>
                    <button type="button" class="hero-modal-close" data-bs-dismiss="modal" aria-label="Close">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="hero-modal-info">
                    <p class="hero-modal-info-text">Use this prompt to let your AI agent execute the workflow &mdash; handling API calls, dependencies and errors automatically.</p>
                    <button type="button" class="hero-run-btn" id="btnRunClaude">
                        <i class="bi bi-play-fill" aria-hidden="true"></i> Run in Claude
                    </button>
                </div>

                <div class="modal-body hero-modal-body">
                    <div class="hero-prompt-card">
                        <div class="hero-prompt-actions">
                            <button type="button" class="hero-prompt-tool" id="btnDownloadPrompt" title="Download as .txt">
                                <i class="bi bi-download"></i>
                            </button>
                            <button type="button" class="hero-prompt-tool" id="btnCopyPrompt" title="Copy prompt">
                                <i class="bi bi-copy"></i>
                            </button>
                        </div>
                        <pre id="modalAgentPromptText" class="hero-prompt-pre">{{flow.agentPrompt}}</pre>
                    </div>
                </div>

            </div>
        </div>
    </div>

    {{!-- Hidden container for spec content --}}
    <textarea id="specContent" style="display: none;">{{flow.content}}</textarea>
</main>
<script src='/technical-scripts/api-flow-detail.js' defer></script>

<head>
    <link rel="stylesheet" href="/technical-styles/agent-prompt.css">
    <link rel="stylesheet" href="/technical-styles/api-workflows.css">
    <script type="application/json" id="apiFlowsDataContainer">{{{json apiFlows}}}</script>
    <script src='/technical-scripts/api-workflows.js' defer></script>
</head>

<main>
    {{> header profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav}}
    {{> sidebar profile=profile baseUrl=baseUrl devportalMode=devportalMode showApiWorkflowsNav=showApiWorkflowsNav}}

    {{!-- Ported to upstream's gallery: the shared page-container / page-header shell, a
          wf-grid of wf-cards, and the dp-empty state. The bespoke .flows-hero heading and
          .flows-empty block it replaces had no counterpart anywhere else in the portal.

          Three things here are ours and have no upstream equivalent, so they are kept:
          the Manage Workflows button (moved into the page header, where the applications
          page puts its own action), the Private/Public visibility badges, and the prompt
          modal below. --}}
    <div class="page-container">
        <div class="page-header">
            <div>
                <h1 class="page-title">API Workflows</h1>
                <p class="page-desc">Pre-configured workflows let your AI agents reference these best practices to use your APIs correctly, every time &mdash; no hallucination, no manual setup.</p>
            </div>
            {{#if profile.isAdmin}}
            {{!-- #apiflows, not bare /configure: api-flows.js reads the hash on load
                  (syncTabFromHash) and anything other than #apiflows falls through to
                  the LLM Instructions tab, so this button landed on the wrong one. --}}
            <a href="{{baseUrl}}/configure#apiflows" class="dp-btn dp-btn--primary">
                <i class="bi bi-pencil-square"></i> Manage Workflows
            </a>
            {{/if}}
        </div>

        {{#if apiFlows.length}}
        <div class="wf-grid">
            {{#each apiFlows}}
            <div class="wf-card" onclick="window.location.href='{{@root.baseUrl}}/api-workflows/{{this.handle}}';">
                <div class="wf-card-head">
                    <h3 class="wf-card-name">{{this.name}}</h3>
                </div>
                <div class="wf-card-body">
                    <p class="wf-card-desc">{{this.description}}</p>
                    {{#if this.sourcesPreview.length}}
                    <div class="wf-powered-label">Powered by</div>
                    <div class="wf-api-pills">
                        {{#each this.sourcesPreview}}
                        <span class="wf-api-pill" title="{{this.name}}">{{this.name}}</span>
                        {{/each}}
                        {{#if sourcesMoreCount}}
                        <span class="wf-api-pill">+{{sourcesMoreCount}} more</span>
                        {{/if}}
                    </div>
                    {{/if}}
                </div>
                <div class="wf-card-footer">
                    {{#if (eq this.visibility "PRIVATE")}}
                    <span class="wf-badge wf-badge--private" title="Only logged-in users can view this workflow">
                        <i class="bi bi-lock-fill"></i> Private
                    </span>
                    {{else}}
                    <span class="wf-badge wf-badge--visibility" title="Visible to all visitors">
                        <i class="bi bi-globe"></i> Public
                    </span>
                    {{/if}}
                    {{#unless (eq this.agentVisibility "HIDDEN")}}
                    <span class="dp-badge dp-badge--ai" title="AI agents can discover and use this workflow">
                        <i class="bi bi-robot"></i> AI Ready
                    </span>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="dp-empty">
            <span class="dp-empty-icon">
                <i class="bi bi-diagram-3"></i>
            </span>
            <h2 class="dp-empty-title">No workflows yet</h2>
            <p class="dp-empty-desc">There are no published workflows available right now. Once they're published, they'll appear here for your AI agents to follow.</p>
        </div>
        {{/if}}
    </div>

    {{!-- Prompt Modal --}}
    <div id="promptModal" class="prompt-modal">
        <div class="prompt-modal-content">
            <div class="prompt-modal-header">
                <h3 id="promptFlowName"></h3>
                <div class="prompt-modal-toolbar">
                    <button class="prompt-tool-btn" id="btnDownloadPrompt" title="Download as .txt">
                        <i class="bi bi-download"></i>
                    </button>
                    <button class="prompt-tool-btn" id="btnCopyPrompt" title="Copy prompt">
                        <i class="bi bi-copy"></i>
                    </button>
                    <button class="btn-run-prompt" id="btnRunClaude">
                        <i class="bi bi-play-fill"></i> Run in Claude
                    </button>
                    <button class="prompt-modal-close" id="promptModalClose" title="Close">&times;</button>
                </div>
            </div>
            <div class="prompt-modal-body">
                <pre class="prompt-text" id="promptText"></pre>
            </div>
        </div>
    </div>

    {{> alert}}
</main>
